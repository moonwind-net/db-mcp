# --- MCP server ---
MCP_PORT=8765

# --- PostgreSQL ---
# When running via docker compose on the shared 'db-net',
# DB_HOST should be the container name.
DB_HOST=db
# If your external Docker network has a different real name, set it here:
# DB_NET_NAME=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# --- Row cap ---
MAX_ROWS=500

# --- Role-based Bearer tokens ---
# Each role's caller must present its token in `Authorization: Bearer <token>`.
# Empty = no token issued for that role (that role is unreachable).
# ALL empty = authentication disabled (dev only, do not expose).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Role hierarchy: admin > write > read
#   read:  ping / list_schemas / list_tables / describe_table / select /
#          execute_sql(SELECT/EXPLAIN/SHOW/WITH...SELECT)
#   write: read + insert / update / delete /
#          execute_sql(INSERT/UPDATE/DELETE)
#   admin: write + execute_sql(DROP/ALTER/CREATE/TRUNCATE/GRANT/REVOKE/...)
MCP_TOKEN_READ=
MCP_TOKEN_WRITE=
MCP_TOKEN_ADMIN=

# Comma-separated URL paths that bypass auth (e.g. health checks).
MCP_AUTH_EXEMPT_PATHS=/healthz
